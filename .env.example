# Local development defaults only. Copy to .env with `make up` or `make db`.
# Replace every secret and encryption key before any shared or production use.
COMPOSE_PROJECT_NAME=atom-local

POSTGRES_USER=atom
POSTGRES_PASSWORD=atom
POSTGRES_DB=atom

ADMIN_SECRET=12345678
ATOM_MIN_PASSWORD_CHARS=8
ATOM_KEY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ATOM_KEY_ENCRYPTION_KEY_ID=local:v1
ATOM_PKI_CA_KEY_ENCRYPTION_KEY=YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODk=
ATOM_PKI_CA_KEY_ENCRYPTION_KEY_ID=local:pki:v1
ATOM_ALLOW_PLAINTEXT_SIGNING_KEYS=false

# Primary HTTP transport bounds. The per-IP default equals the global cap so
# one reverse-proxy address cannot unintentionally throttle every user.
ATOM_HTTP_MAX_CONNECTIONS=1024
ATOM_HTTP_MAX_CONNECTIONS_PER_IP=1024
ATOM_HTTP_HEADER_TIMEOUT_SECS=10
ATOM_HTTP_REQUEST_TIMEOUT_SECS=30
ATOM_HTTP_CONNECTION_TIMEOUT_SECS=300
ATOM_HTTP_SHUTDOWN_DRAIN_TIMEOUT_SECS=30

# The local stack starts without SMTP, OAuth, or certificate enrollment.
ATOM_PKI_ENROLLMENT_ENABLED=false
ATOM_PKI_GENERATED_KEY_ISSUANCE_ENABLED=false
ATOM_ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ATOM_PASSWORD_RESET_REDIRECT=http://localhost:3005/reset-password

# Demo bootstrap and external policy callouts. These are host paths mounted by
# docker-compose.yml at fixed paths inside the Atom container.
ATOM_BOOTSTRAP_FILE=./bootstrap.yaml
ATOM_CALLOUTS_FILE=./callout.yaml
ATOM_CALLOUTS_ENABLED=true
