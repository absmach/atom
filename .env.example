# Local development defaults only. Copy to .env with `make up` or `make db`.
# Replace every secret and encryption key before any shared or production use.
COMPOSE_PROJECT_NAME=atom-local

POSTGRES_USER=atom
POSTGRES_PASSWORD=atom
POSTGRES_DB=atom

ADMIN_SECRET=12345678
ATOM_MIN_PASSWORD_CHARS=8
ATOM_KEY_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ATOM_KEY_ENCRYPTION_KEY_ID=local:v1
ATOM_PKI_CA_KEY_ENCRYPTION_KEY=YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODk=
ATOM_PKI_CA_KEY_ENCRYPTION_KEY_ID=local:pki:v1
ATOM_ALLOW_PLAINTEXT_SIGNING_KEYS=false

# --- Rotating refresh tokens (issue #100) ----------------------------------
# Off by default: login and the GraphQL contract are unchanged until this is
# set. When enabled, login also returns an opaque `atom_rt_...` refresh
# token, and the new `refreshToken` GraphQL mutation exchanges it for a new
# access JWT + rotated refresh token without needing a still-valid JWT.
# Requires ATOM_KEY_ENCRYPTION_KEY (refresh-token secrets are stored only as
# a KEK-keyed HMAC digest, like access tokens).
ATOM_REFRESH_TOKENS_ENABLED=false
# Absolute deadline for a refresh-token family (and, while enabled, for the
# session backing it); rotation never extends it. Must be greater than
# ATOM_ACCESS_TOKEN_EXPIRY_SECS.
ATOM_REFRESH_TOKEN_EXPIRY_SECS=2592000
# Access JWT lifetime while refresh tokens are enabled. Defaults to
# JWT_EXPIRY_SECS; production deployments should shorten this to 10-15
# minutes once clients support the refresh exchange.
# ATOM_ACCESS_TOKEN_EXPIRY_SECS=3600

# Primary HTTP transport bounds. The per-IP default equals the global cap so
# one reverse-proxy address cannot unintentionally throttle every user.
ATOM_HTTP_MAX_CONNECTIONS=1024
ATOM_HTTP_MAX_CONNECTIONS_PER_IP=1024
ATOM_HTTP_HEADER_TIMEOUT_SECS=10
ATOM_HTTP_REQUEST_TIMEOUT_SECS=30
ATOM_HTTP_CONNECTION_TIMEOUT_SECS=300
ATOM_HTTP_SHUTDOWN_DRAIN_TIMEOUT_SECS=30

# The local stack starts without SMTP, OAuth, or certificate enrollment.
ATOM_PKI_ENROLLMENT_ENABLED=false
ATOM_PKI_GENERATED_KEY_ISSUANCE_ENABLED=false

# --- Cache (Redis) --------------------------------------------------------
# Redis-backed cache for AuthN/AuthZ decision *inputs* (session validity,
# entity/tenant status, credential verification, the effective-grants
# expansion) — never the allow/deny decision itself, which is always
# recomputed. Postgres remains authoritative: this is a pure performance
# optimization, off by default, and every check works correctly with it
# disabled. See src/cache/mod.rs for the full consistency model.
#
# Invalidation is precise and synchronous on every relevant mutation. TTLs
# expire payloads only; persistent versions/tokens remain to prevent ABA. A
# lost invalidation leaves a permanent dirty barrier and Postgres fallback.
# While enabled, an unreachable Redis refuses security-sensitive mutations
# (grants/session/credential changes) rather than committing a change the
# cache can't be told about; reads always fall back to Postgres regardless.
#
# With the approved stopped-writer v0.50 -> v1 maintenance upgrade and a fresh
# namespace, all v1 replicas may start directly in `enabled`. `prepare` is for
# rolling transitions or any replica overlap: deploy it everywhere before
# enabling reads. Never mix v0.50/disabled writers with enabled readers.
# `ATOM_CACHE_ENABLED` is a deprecated alias when ATOM_CACHE_MODE is absent.
ATOM_CACHE_MODE=disabled
# ATOM_CACHE_REDIS_URL=redis://redis:6379/0
# Required in prepare/enabled mode; unique per Atom database/deployment.
# ATOM_CACHE_NAMESPACE=example-production
# Set true on exactly the first startup of a new/empty namespace, then unset it.
# Reinitialization is safe only after traffic is stopped and every Atom process
# and in-flight request using this namespace has been fully drained.
# ATOM_CACHE_INITIALIZE_NAMESPACE=false
# ATOM_CACHE_POOL_MAX_SIZE=20
# ATOM_CACHE_CONNECT_TIMEOUT_MS=2000
# A slow Redis must never make auth slower than a Postgres-only path — keep
# this small; a request that misses this timeout just falls through to Postgres.
# ATOM_CACHE_OP_TIMEOUT_MS=50
# If true, an unreachable Redis at startup aborts boot (like an unreachable
# Postgres does). Production should set this true. If false, Atom starts
# unready: reads use Postgres and security-sensitive mutations are refused.
# ATOM_CACHE_FAIL_FAST_ON_STARTUP=true
# Per-category entry TTLs (seconds) — defense-in-depth only, see above.
# ATOM_CACHE_TTL_SESSION_SECS=60
# ATOM_CACHE_TTL_ENTITY_STATUS_SECS=60
# ATOM_CACHE_TTL_TENANT_STATUS_SECS=60
# ATOM_CACHE_TTL_CREDENTIAL_SECS=60
# ATOM_CACHE_TTL_CREDENTIAL_CEILING_SECS=60
# ATOM_CACHE_TTL_GRANTS_SECS=60
# Redis should be network-private (not publicly reachable) and, in any real
# deployment, protected with auth/TLS appropriate to your network — the
# docker-compose `redis` service here is dev-only (loopback-bound, no auth).
# Production requires one dedicated, standalone, non-replicated Redis primary:
# maxmemory-policy=noeviction, save "", appendonly no, Cluster disabled, and no
# Sentinel/automatic failover. Atom verifies these settings with CONFIG GET and
# INFO replication at startup/readiness, so its ACL needs those read commands
# (but should not grant CONFIG SET, FLUSH*, MIGRATE, RESTORE, or replication
# reconfiguration). This topology is intentionally ephemeral: before any Redis
# restart, flush, replacement, repair, or direct SQL/migration that changes a
# cached input without Atom's barrier protocol, stop traffic and fully drain or
# terminate every Atom process and in-flight request, then start a fresh empty
# namespace. A rolling restart is not sufficient.

# --- Audit retention and abuse controls --------------------------------
ATOM_AUDIT_RETENTION_DAYS=365
ATOM_AUDIT_RETENTION_ENABLED=true
ATOM_AUDIT_CLEANUP_INTERVAL_SECS=86400
ATOM_AUDIT_CLEANUP_BATCH_SIZE=5000
# Off by default: successful high-volume authz/auth events stay in metrics/traces.
# Set true only when you need every allow decision in durable DB audit.
ATOM_AUDIT_HOT_PATH_ALLOW_DB_ENABLED=false
ATOM_LOGIN_FAILURE_LIMIT=5
ATOM_LOGIN_FAILURE_WINDOW_SECS=900
ATOM_TRUSTED_PROXY_CIDRS=
# GraphQL introspection is off by default (production-safe). Leave unset to keep
# it off; the atom-dev Compose profile turns it on. Set true only for dev.
# ATOM_GRAPHQL_INTROSPECTION_ENABLED=true

# --- Optional: event publishing (AMQP) ----------------------------------
# Off by default: with no URL set, Atom writes no event_outbox rows and
# starts no delivery task — zero behavior change. When set, every
# audit-worthy operation (create/update/delete, etc.) is queued in
# event_outbox and delivered to this AMQP broker, published to the default
# exchange with one fixed routing key for every event (consumers filter by
# the payload's own "event" field, not by AMQP routing).
# NOTE: if this is set, Atom will fail to start unless the broker is
# reachable at boot (see main.rs) — start your broker first.
# ATOM_EVENTS_AMQP_URL=amqp://guest:guest@localhost:5672/%2f
# Leave empty (default) to publish to the default exchange, which requires
# no topology declaration and works even when Atom's broker credentials are
# restricted to one pre-provisioned queue (e.g. FluxMQ's local-principal
# publish ACL). Set a name to instead declare and publish to a custom
# durable topic exchange.
# ATOM_EVENTS_AMQP_EXCHANGE=
# Routing key used for every published event; under the default exchange
# this doubles as the destination queue name.
# ATOM_EVENTS_AMQP_ROUTING_KEY=atom.events
# Optional mTLS client identity for brokers that require it (e.g. FluxMQ's
# local-principal listener). Cert and key must be set together.
# ATOM_EVENTS_AMQP_TLS_CLIENT_CERT_PATH=
# ATOM_EVENTS_AMQP_TLS_CLIENT_KEY_PATH=
# Optional CA bundle to verify the broker's server certificate (amqps:// only).
# ATOM_EVENTS_AMQP_TLS_CA_PATH=
# ATOM_EVENTS_OUTBOX_POLL_INTERVAL_SECS=5
# ATOM_EVENTS_OUTBOX_BATCH_SIZE=100
# Only bounds retries for a row whose payload can never be parsed (e.g. left
# over from an older schema_version) — retrying that can never succeed.
# A row that fails to publish (broker outage, etc.) always keeps retrying
# regardless of this value, however long the outage lasts.
# ATOM_EVENTS_OUTBOX_MAX_ATTEMPTS=10
# How long Atom waits on the broker for any single operation — one delivery
# attempt, or the initial connect at startup — before giving up and either
# retrying later (delivery) or failing startup (connect). Guards against a
# broker that accepts the connection but stalls rather than erroring
# outright.
# ATOM_EVENTS_PUBLISH_TIMEOUT_SECS=30

# --- Metrics ------------------------------------------------------------
# Prometheus metrics at GET /metrics. On by default. Set false to skip the
# recorder and unmount /metrics (no rebuild); for a zero-cost build compile with
# `--no-default-features`. /metrics is UNAUTHENTICATED — network-restrict it to
# your scraper in production.
# ATOM_METRICS_ENABLED=false

# --- gRPC TLS -----------------------------------------------------------
# Off by default (plaintext) — fine for local dev. In production, either enable
# TLS here or confine gRPC to a private network / service mesh. Set both cert and
# key to enable server TLS; add the client CA to require client certs (mTLS).
# Compose mounts ATOM_PKI_CERTS_DIR at /certs:ro, so container paths can be:
# ATOM_GRPC_TLS_CERT_PATH=/certs/grpc-server.crt
# ATOM_GRPC_TLS_KEY_PATH=/certs/grpc-server.key
# ATOM_GRPC_TLS_CLIENT_CA_PATH=/certs/grpc-client-ca.crt
# For cargo run, use host paths instead, for example ./certs/grpc-server.crt.
# Broker auth is off by default. Enabling it without all three gRPC TLS paths
# above fails startup: the broker callout is authenticated exclusively by its
# verified client certificate.
# ATOM_BROKER_AUTH_ENABLED=false
# ATOM_BROKER_TOPIC_TEMPLATE={resource}/#
# ATOM_BROKER_TOPIC_REF=alias
# ATOM_BROKER_CREDENTIAL_KIND=password
# ATOM_BROKER_TOPIC_ALLOW=

# --- Local convenience --------------------------------------------------
# Allow password login before email verification, so local dev needs no SMTP.
ATOM_ALLOW_UNVERIFIED_EMAIL_LOGIN=true
ATOM_PASSWORD_RESET_REDIRECT=http://localhost:3005/reset-password

# Demo bootstrap and external policy callouts. These are host paths mounted by
# docker-compose.yml at fixed paths inside the Atom container.
ATOM_BOOTSTRAP_FILE=./config/demo/bootstrap.yaml
ATOM_CALLOUTS_FILE=./config/demo/callouts.yaml
ATOM_CALLOUTS_ENABLED=true
