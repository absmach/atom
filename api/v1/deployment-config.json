  "parsing": {
    "booleanTruthyValues": ["1", "true", "yes", "on"],
    "booleanFalseValues": ["0", "false", "no", "off"],
    "booleanRule": "Values are trimmed and matched case-insensitively. Any other present value, including blank, fails startup.",
    "uuidOverrides": {
      "variables": ["ADMIN_ENTITY_ID", "ATOM_SERVICE_ENTITY_ID"],
      "rule": "A configured value must be a valid UUID; malformed or blank values fail startup instead of selecting the reserved default identity."
    },
    "positiveAuthLifetimeSeconds": {
      "variables": [
        "JWT_EXPIRY_SECS",
        "ATOM_EMAIL_VERIFICATION_EXPIRY_SECS",
        "ATOM_INVITATION_EXPIRY_SECS",
        "ATOM_OAUTH_STATE_EXPIRY_SECS",
        "ATOM_AUTH_EXCHANGE_CODE_EXPIRY_SECS"
      ],
      "rule": "A configured value must be a positive u64 whose duration and expiration timestamp are representable; malformed, zero, or out-of-range values fail startup."
    },
    "blankAsUnset": [
      "ATOM_BOOTSTRAP_FILE",
      "ATOM_CACHE_MODE",
      "ATOM_CACHE_NAMESPACE",
      "ATOM_EMAIL_TEMPLATES_DIR",
      "ATOM_EVENTS_AMQP_URL",
      "ATOM_EVENTS_AMQP_TLS_CA_PATH",
      "ATOM_EVENTS_AMQP_TLS_CLIENT_CERT_PATH",
      "ATOM_EVENTS_AMQP_TLS_CLIENT_KEY_PATH",
      "ATOM_GRPC_TLS_CERT_PATH",
      "ATOM_GRPC_TLS_CLIENT_CA_PATH",
      "ATOM_GRPC_TLS_KEY_PATH",
      "ATOM_LOG_LEVEL",
      "ATOM_PKI_CA_KEY_ENCRYPTION_KEY",
      "ATOM_PKI_ENROLLMENT_TLS_CERT_PATH",
      "ATOM_PKI_ENROLLMENT_TLS_KEY_PATH",
      "ATOM_PKI_PLATFORM_INTERMEDIATE_CERT_PATH",
      "ATOM_PKI_PLATFORM_INTERMEDIATE_KEY_PATH",
      "ATOM_PKI_ROOT_CERT_PATH",
      "ATOM_PUBLIC_BASE_URL"
    ],
    "acceptedEnums": {
      "ATOM_BROKER_CREDENTIAL_KIND": ["password", "shared_key"],
      "ATOM_BROKER_TOPIC_REF": ["alias", "uuid"],
      "ATOM_CACHE_MODE": ["disabled", "prepare", "enabled"],
      "ATOM_LOG_FORMAT": ["text", "json"],
      "ATOM_PKI_CA_KEY_BACKEND": ["encrypted_database", "pkcs11"],
      "ATOM_SMTP_TLS": ["none", "starttls", "tls"]
    }
  },
  "precedenceAndAliases": [
    {
      "primary": "ATOM_LOG_LEVEL",
      "fallback": "RUST_LOG",
      "rule": "The first non-blank value wins; info is used when both are unset or blank."
    },
    {
      "primary": "ATOM_CACHE_MODE",
      "deprecatedAlias": "ATOM_CACHE_ENABLED",
      "rule": "When mode is absent, an explicit true alias selects enabled and an explicit false alias selects disabled. Blank or invalid alias values fail startup. When both are present, enabled/true and disabled/false are accepted; all other combinations fail startup."
    }
  ],
  "activationAndFailFastConditions": [
    {
      "variables": ["ATOM_CALLOUTS_ENABLED", "ATOM_CALLOUTS_FILE"],
      "rule": "Callouts are disabled when ENABLED is explicitly false or FILE is unset/blank; otherwise the file is loaded."
    },
    {
      "variables": ["ATOM_EVENTS_AMQP_URL"],
      "rule": "A non-blank URL enables transactional outbox enqueue and publishing."
    },
    {
      "variables": ["ATOM_EVENTS_AMQP_TLS_CLIENT_CERT_PATH", "ATOM_EVENTS_AMQP_TLS_CLIENT_KEY_PATH"],
      "rule": "Both client identity paths must be set together or startup fails."
    },
    {
      "variables": ["ATOM_GRPC_TLS_CERT_PATH", "ATOM_GRPC_TLS_KEY_PATH", "ATOM_GRPC_TLS_CLIENT_CA_PATH"],
      "rule": "Server cert and key must be set together. Client CA requires the server pair; setting it enables mandatory mTLS."
    },
    {
      "variables": ["ATOM_BROKER_AUTH_ENABLED", "ATOM_GRPC_TLS_CERT_PATH", "ATOM_GRPC_TLS_KEY_PATH", "ATOM_GRPC_TLS_CLIENT_CA_PATH"],
      "rule": "Broker auth may be enabled only with gRPC mTLS; otherwise startup fails. Broker topic settings are read only while broker auth is enabled."
    },
    {
      "variables": ["ATOM_PKI_ENROLLMENT_TLS_CERT_PATH", "ATOM_PKI_ENROLLMENT_TLS_KEY_PATH", "ATOM_PKI_ENROLLMENT_ENABLED"],
      "rule": "Enrollment cert and key must be set together even when disabled. Enabling enrollment requires the pair."
    },
    {
      "variables": ["ATOM_PKI_ENROLLMENT_REQUEST_BODY_TIMEOUT_SECS"],
