  "compatibilityRule": "Event names, target-kind meanings, outcome profiles, publication profiles, and required detail keys are frozen for v1. Detail objects may gain optional keys; consumers must ignore keys they do not understand.",
  "outcomeProfiles": {
    "operation": ["allow", "deny", "error"],
    "decision": ["allow", "deny"],
    "allow_only": ["allow"],
    "deny_only": ["deny"]
  },
  "publicationProfiles": {
    "mutation": "An allow is enqueued in the mutation transaction when ATOM_EVENTS_AMQP_URL is configured. Resolver/transport failures are best-effort enqueued with deny or error after the failed operation. Stdout observation is always emitted; the documented compliance-audit subset is also written to audit_logs.",
    "audit": "Written through the fire-and-forget audit path and copied to the outbox only when ATOM_EVENTS_AMQP_URL is configured.",
    "hot_path": "Deny is audited/published when event publishing is configured. Allow is suppressed by default and is audited/published only when ATOM_AUDIT_HOT_PATH_ALLOW_DB_ENABLED is true.",
    "replay_audit_only": "An idempotent replay is written to audit/stdout with event publishing explicitly disabled; it is not placed in the broker outbox.",
    "lifecycle_outbox": "Enqueued only by the enabled PKI lifecycle sweep and only while event publishing is configured; the notification claim and outbox row share one transaction.",
    "cleanup": "Emitted only after a configured cleanup run deletes at least one row; copied to the outbox only when event publishing is configured.",
    "internal_observation": "Internal compatibility wrapper emits stdout observation with event publishing disabled."
  },
